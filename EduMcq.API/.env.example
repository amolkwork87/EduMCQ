# .env.example - Commit this to Git!
# Copy this file to .env and fill in your values
# NEVER commit .env to Git!

ASPNETCORE_ENVIRONMENT=Development

# JWT Settings
JWT__SECRETKEY=your-super-secret-jwt-key-min-16-characters
JWT__ISSUER=localhost
JWT__AUDIENCE=localhost-users
JWT__EXPIRYMINUTES=60


# Connection Strings
EDUMCQDATABASECONNECTION=local-connection-string;

# Google OAuth
AUTHENTICATION__GOOGLE__CLIENTID=your-google-client-id.apps.googleusercontent.com
AUTHENTICATION__GOOGLE__CLIENTSECRET=your-google-client-secret

# Facebook OAuth
AUTHENTICATION__FACEBOOK__APPID=your-facebook-app-id
AUTHENTICATION__FACEBOOK__APPSECRET=your-facebook-app-secret


