{
  "version": "0.2.0",
  "configurations": [
    
    {
      "name": "EduMcqAPI",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "buildEduMcq",
      "program": "${workspaceFolder}/EduMcq.API/bin/Debug/net10.0/EduMcq.API.dll",
      "args": [],
      "cwd": "${workspaceFolder}/EduMcq.API",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    }
  ],
  "compounds": [
    ]
}