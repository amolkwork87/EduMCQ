{
  "HttpTimeoutSettings": {
    "TokenizationHttpTimeout": ""
    
  },
  "AllowedHosts": "*",
  "MaskSensitiveData": "true",
  "EduMcqDatabaseConnection": "",
  "OspreyModuleURL": "http://20.85.173.19:9200",  
  "DbMigrationPath": "DB",  
  "MigrateData": "true",
  "regionid": "eastus",
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Error",
      "Microsoft.Hosting.Lifetime": "Error",
      "Microsoft.Extensions.Http.Logging.LoggingHttpMessageHandler": "Information",
      "Microsoft.Extensions.Http.Logging.LoggingScopeHttpMessageHandler": "Information"
    }
  },
  "Jwt":
  {
    "Key": "6407d07f59551d969a98c640853bbc8e7d46b0b043574e11f4cd413a46935bcf",
    "Issuer": "TrackPulse",
    "Audience": "TrackPulseUsers",
    "ExpiresInMinutes": 15
  },
  "NLog": {
    "extensions": [
      {
        "assembly": "NLog.Loki"
      },
      {
        "assembly": "NLog.Web.AspNetCore"
      },
      {
        "assembly": "NLog.Extensions.Logging"
      },
      {
        "assembly": "NLog.Extensions.AzureBlobStorage"
      }
    ],
    "targets": {
      "lokiTesla": {
        "name": "loki",
        "type": "loki",
        "batchSize": "1",
        "taskDelayMilliseconds": "500",
        "endpoint": "http://loki-stack.monitoring:3100",
        "orderWrites": "true",
        "compressionLevel": "noCompression",
        "label": {
          "name": "tesla",
          "layout": "edumcq"
        },
        "layout": {
          "type": "JsonLayout",
          "Attributes": [
            {
              "name": "message",
              "encode": false,
              "layout": "${message}"
            },
            {
              "name": "application",
              "layout": "edumcq"
            },
            {
              "name": "datetime",
              "layout": "${longdate}"
            },
            {
              "name": "logLevel",
              "layout": "${uppercase:${level}}"
            },
            {
              "name": "methodUrl",
              "layout": "${aspnet-request-url}"
            },
            {
              "name": "idempotencyId",
              "layout": "${aspnet-request-headers:HeaderNames=IdempotencyId:ValuesOnly=true}"
            },
            {
              "name": "callsite",
              "layout": "${callsite:className=true:fileName=false:includeSourcePath=true:methodName=true}"
            }
          ]
        }
      },
      "lokiTesla-Stats": {
        "name": "loki",
        "type": "loki",
        "batchSize": "1",
        "taskDelayMilliseconds": "500",
        "endpoint": "http://loki-stack.monitoring:3100",
        "orderWrites": "true",
        "compressionLevel": "noCompression",
        "label": {
          "name": "tesla_stats",
          "layout": "edumcq"
        },
        "layout": {
          "type": "JsonLayout",
          "Attributes": [
            {
              "name": "message",
              "encode": false,
              "layout": "${message}"
            },
            {
              "name": "application",
              "layout": "edumcq"
            },
            {
              "name": "datetime",
              "layout": "${longdate}"
            },
            {
              "name": "logLevel",
              "layout": "${uppercase:${level}}"
            },
            {
              "name": "methodUrl",
              "layout": "${aspnet-request-url}"
            },
            {
              "name": "idempotencyId",
              "layout": "${aspnet-request-headers:HeaderNames=IdempotencyId:ValuesOnly=true}"
            },
            {
              "name": "callsite",
              "layout": "${callsite:className=true:fileName=false:includeSourcePath=true:methodName=true}"
            }
          ]
        }
      },
      "azure": {
        "name": "azure",
        "type": "AzureBlobStorage",
        "connectionString": "${environment:AzureConnectionString}",
        "container": "recon",
        "blobName": "Recon-${shortdate}.log",
        "layout": "${message}"
      },
      "azureOutboxMessages": {
        "name": "azure",
        "type": "AzureBlobStorage",
        "connectionString": "${environment:AzureConnectionString}",
        "container": "outbox-messages",
        "blobName": "OutboxMessages-${shortdate}.log",
        "layout": "${message}"
      },
      "console": {
        "name": "console",
        "type": "ColoredConsole",
        "layout": {
          "type": "JsonLayout",
          "Attributes": [
            {
              "name": "message",
              "encode": false,
              "layout": "${message}"
            },
            {
              "name": "application",
              "layout": "edumcq"
            },
            {
              "name": "datetime",
              "layout": "${longdate}"
            },
            {
              "name": "logLevel",
              "layout": "${uppercase:${level}}"
            },
            {
              "name": "methodUrl",
              "layout": "${aspnet-request-url}"
            },
            {
              "name": "idempotencyId",
              "layout": "${aspnet-request-headers:HeaderNames=IdempotencyId:ValuesOnly=true}"
            },
            {
              "name": "callsite",
              "layout": "${callsite:className=true:fileName=false:includeSourcePath=true:methodName=true}"
            }
          ]
        }
      }
    },
    "rules": [
      {
        "logger": "*",
        "minLevel": "Warn",
        "maxLevel": "Fatal",
        "writeTo": "lokiTesla"
      },
      
      {
        "logger": "*",
        "minLevel": "Warn",
        "maxLevel": "Fatal",
        "writeTo": "console"
      }
    ]
  }
}